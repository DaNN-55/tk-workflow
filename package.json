{
  "name": "loop-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:build": "tsc -p tsconfig.worker.json",
    "worker:run": "npm run worker:build && node dist/worker/worker/codexWorkerCli.js",
    "publish:prepare": "npm run worker:build && node dist/worker/publishing/publishPackageCli.js",
    "publish:register-input": "npm run worker:build && node dist/worker/publishing/publishInputCli.js",
    "publish:verify": "npm run worker:build && node dist/worker/publishing/publishPackageVerifyCli.js",
    "orchestrator:build": "tsc -p tsconfig.orchestrator.json",
    "orchestrator:run": "npm run orchestrator:build && node dist/orchestration/orchestration/loopOrchestratorCli.js",
    "db:migrations:check": "node scripts/supabase-migrations.mjs",
    "db:migrations:deploy": "node scripts/supabase-migrations.mjs --deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "gsap": "3.14.2",
    "hyperframes": "0.7.109",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
